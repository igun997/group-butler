# =============================================================================
# Group Butler — local development environment
#
#   cp .env.example .env      # then edit the R2 values below and you are done
#
# scripts/dev.sh sources this file with
#   set -a; . ./.env; set +a
# so every value MUST be a bare, space-free shell token. Keep the sections in
# sync with packages/shared/src/env-contract.ts (a test enforces it).
#
# Media storage is Cloudflare R2 — the real service — in development and in
# production. There is no local S3 emulator and no endpoint override anywhere in
# this project: the endpoint is derived from R2_ACCOUNT_ID in code. Use a DEV
# bucket below; never point local development at the production bucket.
# =============================================================================

# --- Shared -------------------------------------------------------------------
# Tenancy boundary. Single organisation today; every document carries it.
ORGANIZATION_ID=org_default
# Country code applied when a phone is written in national form (`0899…`), so
# the operator can type their number the way their own phone shows it. The
# worker and the BFF must share this value or the reply gate will not match.
DEFAULT_COUNTRY_CODE=62
# The clock the assistant writes times in (an IANA zone). Stored times stay UTC;
# this is what a recap or a history line is rendered in, so it should be the zone
# the operator reads their own phone in. An unusable value falls back to
# Asia/Jakarta rather than breaking every message that carries a time.
DISPLAY_TIMEZONE=Asia/Jakarta
# Local Mongo replica set (infra/dev/docker-compose.yml). The member host must be
# 127.0.0.1 because the web app and the worker run on the host, not in Docker.
MONGODB_URI=mongodb://127.0.0.1:27017/group_butler?replicaSet=rs0
MONGODB_DB=group_butler
# debug | info | warn | error
LOG_LEVEL=debug
# development enables the local defaults; production makes both services refuse
# to boot on missing or placeholder secrets.
ENVIRONMENT=development

# --- Worker control plane -----------------------------------------------------
# The worker listens here; the BFF calls it with WORKER_SECRET.
PORT=4000
WORKER_URL=http://127.0.0.1:4000
# Local placeholder only. Production MUST use 32+ random bytes.
WORKER_SECRET=dev-secret
# RETIRED: the worker holds no WhatsApp session and reads nothing here. Kept because
# packages/shared/src/env-contract.ts still lists it; the linked-device keys live in Hermes.
# in production, in a git-ignored folder locally.

# --- Object storage: Cloudflare R2 (REQUIRED for media) -----------------------
# The four values below are REQUIRED: without them media ingest, the `unparsed`
# capture path and every presigned read cannot work. The dev launcher refuses to
# start with an actionable message while any of them is still a placeholder.
#
#   R2_ACCOUNT_ID          Cloudflare dashboard -> R2 -> Overview -> Account ID
#   R2_ACCESS_KEY_ID       Cloudflare dashboard -> R2 -> Manage API Tokens
#   R2_SECRET_ACCESS_KEY   Cloudflare dashboard -> R2 -> Manage API Tokens
#   R2_BUCKET              the name of your DEV bucket
#
# The endpoint is NOT configurable: it is derived as
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=group-butler-dev
# Optional: a CDN/custom domain for direct object reads. Empty means the BFF
# mints short-lived presigned URLs instead (the default).
R2_PUBLIC_URL=
# Signed-URL lifetime in seconds: a positive integer no larger than 604800
# (7 days, the SigV4 maximum). The BFF refuses to sign a URL outside that range
# rather than silently rounding it.
R2_PRESIGN_TTL_SECONDS=300

# --- Dashboard owner auth -----------------------------------------------------
# ONE owner account. No signup, no roles, no OAuth, no proxy-header trust.
OWNER_EMAIL=owner@local
# Dev convenience; the BFF refuses to read this when ENVIRONMENT=production.
OWNER_PASSWORD=changeme
# Preferred in production: `bun run auth:hash '<password>'`. Empty = unused.
# Single-quote what that command prints: this file is sourced by the shell, and the
# hash is `scrypt$16384$8$1$…`, so an unquoted `$` is expanded and the stack refuses
# to start. OWNER_PASSWORD_HASH='scrypt$16384$8$1$<salt>$<hash>'
OWNER_PASSWORD_HASH=
# >=32 chars. Rotating this signs every session out.
AUTH_SECRET=dev-only-auth-secret-change-me-32ch
# Login attempts per client per 15 minutes.
LOGIN_RATE_LIMIT=5
# How many of YOUR OWN reverse proxies sit in front of the BFF (each appending
# or replacing X-Forwarded-For). 0 = trust no forwarded header at all: every
# login shares one rate-limit bucket, so a forged X-Forwarded-For cannot buy
# fresh attempts, and audit rows record `direct` instead of an address. Set it to
# 1 behind a single trusted proxy, and never higher than the number of your own
# proxies — the app's port must also be unreachable except through them.
TRUSTED_PROXY_HOPS=0

# --- AI provider --------------------------------------------------------------
# Any OpenAI-compatible endpoint; the AI SDK provider is swappable.
AI_BASE_URL=https://llm.example.invalid/v1
AI_API_KEY=placeholder-ai-key
AI_MODEL=placeholder-model
AI_MAX_TOKENS_PER_DAY=200000
# Automatic replies measure every model request against the 180k ceiling and
# refuse to call the model when they cannot. This names the counter that must do
# the measuring, and the id has to be one the BFF process has REGISTERED.
# The BFF bundles gpt-tokenizer and registers `o200k-upper-bound` at startup
# (src/instrumentation.ts): the o200k_base BPE, declared `upper_bound` with a
# x1.1 margin because AI_MODEL here is a DeepSeek model behind an
# OpenAI-compatible gateway and o200k is not its tokenizer. The multiplier is
# what makes that count a bound, so an upper-bound counter is accepted; nothing
# is claimed to be an exact provider count. An EMPTY or unknown id is refused
# rather than guessed at (502 token_counter_unavailable, no model call), which
# is the safe failure for a deployment that names a counter this process does
# not hold.
AI_TOKENIZER=o200k-upper-bound

# --- Agent memory batches -----------------------------------------------------
MEMORY_BATCH_INTERVAL=30s
MEMORY_BATCH_CONCURRENCY=2
# The worker invokes the BFF with this distinct bearer secret after it leases a batch.
MEMORY_CALLBACK_URL=http://127.0.0.1:3000/api/internal/memory-batches
MEMORY_CALLBACK_SECRET=dev-memory-callback-secret

# --- Worker ingest ------------------------------------------------------------
# Bounded batch queue; overflow increments runtime.ingest.droppedTotal.
INGEST_QUEUE_SIZE=512
INGEST_FLUSH_MS=250
INGEST_FLUSH_MAX=100
# The raw message tree and its flattened search text are truncated.
RAW_JSON_MAX_BYTES=32768
RAW_SEARCH_MAX_BYTES=8192

# --- Hermes bridge ingest -----------------------------------------------------
# Hermes owns WhatsApp; its bridge POSTs every inbound message to the worker's
# /ingest, including the ones the agent ignores, so the archive is the group's
# chatter rather than only the messages that woke the agent.
#
# The instance every archived message is stored under. It MUST match the instance
# row the console shows, or the archived traffic lands under an id nothing lists.
HERMES_INSTANCE_ID=inst_hermes
# Where that bridge listens. Hermes binds it to loopback inside its own container
# and it carries no token of its own, so this is only ever a local address: the
# worker's group reads, group writes and approved sends are calls to it now, and a
# value the worker cannot call stops it at startup.
HERMES_BRIDGE_URL=http://127.0.0.1:3000
# Where the Hermes container's data volume is mounted on this host. Attachment
# paths arrive as container paths (/opt/data/...), because the bridge downloads
# them itself; the prefix is remapped onto this root. Leave EMPTY when the worker
# runs on the same filesystem the bridge wrote to.
HERMES_DATA_DIR=
# Bounded queue that carries group/receipt Mongo writes off the whatsmeow event
# loop; overflow is counted and logged rather than stalling the protocol.

# --- Worker media -------------------------------------------------------------
MEDIA_MAX_BYTES=26214400
MEDIA_CONCURRENCY=4
MEDIA_DOWNLOAD_TIMEOUT=45s
# Transcription/vision/doc extraction — off by default (spends tokens).
MEDIA_ENRICH_ENABLED=false
# 0 = keep messages forever.
RETENTION_MESSAGES_DAYS=0

# --- Group discovery and sync -------------------------------------------------
# Full GetJoinedGroups reconcile — the offline-rename safety net.
GROUP_SYNC_INTERVAL=30m
# Per-group GetGroupInfo repair threshold.
GROUP_STALE_AFTER=6h
# false disables marking groups absent from a sync as left.
GROUP_SYNC_PRUNE=true

# --- Sends / dispatch ---------------------------------------------------------
DISPATCH_INTERVAL=5s
SEND_MAX_ATTEMPTS=3

# --- Live updates -------------------------------------------------------------
# SSE (Mongo change streams) is the default transport; this is the polling
# fallback interval used when change streams are unavailable. The dashboard
# interface is identical either way.
STREAM_POLL_MS=3000
